@@ -0,0 +1,185 @@
+import { create } from 'zustand';
+
+import { loadSettings, saveSetting } from '@/db';
+import { swallow } from '@/utils/log';
+
+/**
+ * WHATSAPP AGENT STATE — configuration, per-participant conversation history,
+ * the poll offset and the last-run day of each scheduled message. Persisted
+ * as one JSON blob in `app_settings` (key `waAgent`). Runtime status (is the
+ * poller alive, last error) is NOT persisted.
+ */
+
+export interface WaSchedule {
+  enabled: boolean;
+  /** Local time "HH:MM". */
+  time: string;
+}
+
+export interface WaConfig {
+  enabled: boolean;
+  /** WhatsApp Cloud Agent bearer key. */
+  apiKey: string;
+  /** Phones / participant ids allowed to talk to the agent. */
+  adminPhones: string[];
+  /** The participant id the agent paired with (Meta hides phones behind these). */
+  lastActiveUserId: string | null;
+  /** Writes wait for CONFIRM ACT-XXXX (off = the agent saves immediately). */
+  requireConfirmation: boolean;
+  briefing: WaSchedule;
+  wages: WaSchedule & { minDays: number };
+  udhaar: WaSchedule & { weekday: number };
+  orders: WaSchedule & { minDays: number };
+}
+
+export interface WaTurn {
+  role: 'user' | 'assistant';
+  text: string;
+  /** ISO timestamp. */
+  at: string;
+}
+
+export interface WaStatus {
+  running: boolean;
+  lastPollAt: string | null;
+  lastError: string | null;
+  lastMessageAt: string | null;
+  messagesToday: number;
+  /** Local day the counter belongs to. */
+  countDay: string;
+}
+
+export const DEFAULT_WA_CONFIG: WaConfig = {
+  enabled: false,
+  apiKey: '',
+  adminPhones: [],
+  lastActiveUserId: null,
+  requireConfirmation: true,
+  briefing: { enabled: true, time: '09:00' },
+  wages: { enabled: true, time: '11:00', minDays: 3 },
+  udhaar: { enabled: true, time: '10:00', weekday: 1 },
+  orders: { enabled: true, time: '17:00', minDays: 7 },
+};
+
+const KEY = 'waAgent';
+const MAX_TURNS_PER_PHONE = 40;
+const MAX_PHONES = 10;
+
+interface Persisted {
+  config: WaConfig;
+  histories: Record<string, WaTurn[]>;
+  nextOffset?: number;
+  lastRuns: Record<string, string>;
+}
+
+interface WaState extends Persisted {
+  status: WaStatus;
+  hydrated: boolean;
+  hydrate: () => Promise<void>;
+  setConfig: (patch: Partial<WaConfig>) => void;
+  appendTurn: (phone: string, turn: WaTurn) => void;
+  clearHistory: () => void;
+  setOffset: (offset: number | undefined) => void;
+  markRun: (key: string, day: string) => void;
+  setStatus: (patch: Partial<WaStatus>) => void;
+  /** The most recent turns of one participant, oldest first. */
+  turnsFor: (phone: string) => WaTurn[];
+}
+
+const localDay = (): string => {
+  const d = new Date();
+  const p = (n: number) => String(n).padStart(2, '0');
+  return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`;
+};
+
+function persist(get: () => WaState): void {
+  const { config, histories, nextOffset, lastRuns } = get();
+  const payload: Persisted = { config, histories, nextOffset, lastRuns };
+  void saveSetting(KEY, JSON.stringify(payload)).catch(swallow('whatsapp:persist'));
+}
+
+/** Tolerant read of a saved blob (older shapes fall back to defaults). */
+function parsePersisted(raw: string | undefined): Persisted {
+  const base: Persisted = { config: { ...DEFAULT_WA_CONFIG }, histories: {}, nextOffset: undefined, lastRuns: {} };
+  if (!raw) return base;
+  try {
+    const o = JSON.parse(raw) as Partial<Persisted>;
+    const c = (o.config ?? {}) as Partial<WaConfig>;
+    return {
+      config: {
+        ...DEFAULT_WA_CONFIG,
+        ...c,
+        adminPhones: Array.isArray(c.adminPhones) ? c.adminPhones.filter((p): p is string => typeof p === 'string') : [],
+        briefing: { ...DEFAULT_WA_CONFIG.briefing, ...(c.briefing ?? {}) },
+        wages: { ...DEFAULT_WA_CONFIG.wages, ...(c.wages ?? {}) },
+        udhaar: { ...DEFAULT_WA_CONFIG.udhaar, ...(c.udhaar ?? {}) },
+        orders: { ...DEFAULT_WA_CONFIG.orders, ...(c.orders ?? {}) },
+      },
+      histories: o.histories && typeof o.histories === 'object' ? (o.histories as Record<string, WaTurn[]>) : {},
+      nextOffset: typeof o.nextOffset === 'number' ? o.nextOffset : undefined,
+      lastRuns: o.lastRuns && typeof o.lastRuns === 'object' ? (o.lastRuns as Record<string, string>) : {},
+    };
+  } catch {
+    return base;
+  }
+}
+
+export const useWhatsAppStore = create<WaState>((set, get) => ({
+  config: { ...DEFAULT_WA_CONFIG },
+  histories: {},
+  nextOffset: undefined,
+  lastRuns: {},
+  status: { running: false, lastPollAt: null, lastError: null, lastMessageAt: null, messagesToday: 0, countDay: localDay() },
+  hydrated: false,
+
+  hydrate: async () => {
+    try {
+      const s = await loadSettings();
+      set({ ...parsePersisted(s[KEY]), hydrated: true });
+    } catch {
+      set({ hydrated: true });
+    }
+  },
+
+  setConfig: (patch) => {
+    set({ config: { ...get().config, ...patch } });
+    persist(get);
+  },
+
+  appendTurn: (phone, turn) => {
+    const histories = { ...get().histories };
+    const turns = [...(histories[phone] ?? []), turn].slice(-MAX_TURNS_PER_PHONE);
+    histories[phone] = turns;
+    // Keep the newest few participants only.
+    const keys = Object.keys(histories);
+    if (keys.length > MAX_PHONES) {
+      const oldest = keys.sort((a, b) => (histories[a].at(-1)?.at ?? '').localeCompare(histories[b].at(-1)?.at ?? '')).slice(0, keys.length - MAX_PHONES);
+      for (const k of oldest) delete histories[k];
+    }
+    const day = localDay();
+    const status = get().status;
+    const messagesToday = (status.countDay === day ? status.messagesToday : 0) + (turn.role === 'user' ? 1 : 0);
+    set({ histories, status: { ...status, countDay: day, messagesToday, lastMessageAt: turn.at } });
+    persist(get);
+  },
+
+  clearHistory: () => {
+    set({ histories: {} });
+    persist(get);
+  },
+
+  setOffset: (nextOffset) => {
+    if (nextOffset === get().nextOffset) return;
+    set({ nextOffset });
+    persist(get);
+  },
+
+  markRun: (key, day) => {
+    set({ lastRuns: { ...get().lastRuns, [key]: day } });
+    persist(get);
+  },
+
+  setStatus: (patch) => set({ status: { ...get().status, ...patch } }),
+
+  turnsFor: (phone) => get().histories[phone] ?? [],
+}));

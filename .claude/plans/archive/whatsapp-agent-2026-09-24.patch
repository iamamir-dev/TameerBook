new file mode 100644
index 0000000..603c8c4
--- /dev/null
+++ b/src/modules/whatsapp/handle.ts
@@ -0,0 +1,244 @@
+import {
+  addFact,
+  buildWorld,
+  decideReplyLanguage,
+  detectLanguage,
+  getAiTransport,
+  isAiError,
+  memoryBlock,
+  noteAccepted,
+  noteLanguage,
+  runAgent,
+  runIntent,
+  type AiChatMessage,
+  type AiErrorCode,
+  type Answer,
+  type ReplyLanguage,
+  type ResolvedDraft,
+  type World,
+} from '@/ai';
+import { listProjectLaborers } from '@/db';
+import { useSettingsStore } from '@/stores/useSettingsStore';
+import { todayISO } from '@/utils/date';
+import { formatRupees } from '@/utils/money';
+import { reportError, swallow } from '@/utils/log';
+
+import { applyDraft, type DraftChoices } from '@/modules/assistant/utils/applyDraft';
+import { loadMemory, saveMemory } from '@/modules/assistant/utils/memoryStore';
+
+import { isAdminParticipant } from './access';
+import type { InboundMessage } from './api';
+import { clampWhatsApp, confirmFooter, newActionId, optionsBlock, parseCommand, resolveNumberedReply, toWhatsAppText } from './format';
+import { useWhatsAppStore, type WaTurn } from './store';
+
+/**
+ * ONE INBOUND WHATSAPP MESSAGE → ONE REPLY. The same agent loop, tools,
+ * gap checks, memory and language rules as the in-app chat; the differences
+ * are all about the channel:
+ *
+ *   - no cards: the numbers a tool returned are restated in plain lines;
+ *   - no tap chips: OPTIONS become a numbered list the user answers by number;
+ *   - no Accept button: a proposed write is staged as ACT-XXXX and saved only
+ *     when the user replies CONFIRM ACT-XXXX (or a plain "haan" / "ok" for the
+ *     latest one). Pending actions expire after ten minutes.
+ */
+
+export interface PendingAction {
+  id: string;
+  phone: string;
+  drafts: ResolvedDraft[];
+  lang: ReplyLanguage;
+  createdAt: number;
+}
+
+const PENDING_TTL_MS = 10 * 60_000;
+const pending = new Map<string, PendingAction>();
+/** Choices offered in the last reply, per participant, so "2" can be resolved. */
+const lastOptions = new Map<string, string[]>();
+
+const sweep = (): void => {
+  const now = Date.now();
+  for (const [id, a] of pending) if (now - a.createdAt > PENDING_TTL_MS) pending.delete(id);
+};
+
+/** The newest pending action of one participant. */
+function latestPending(phone: string): PendingAction | undefined {
+  sweep();
+  let best: PendingAction | undefined;
+  for (const a of pending.values()) if (a.phone === phone && (!best || a.createdAt > best.createdAt)) best = a;
+  return best;
+}
+
+/** Exposed for the admin screen (count only). */
+export const pendingCount = (): number => {
+  sweep();
+  return pending.size;
+};
+
+const DENIED = 'This number is not allowed to use the TameerBook agent.\nYeh number TameerBook agent ke liye allowed nahi hai. Apna number app ki Settings → WhatsApp agent mein add karein.';
+
+const ERRORS: Record<AiErrorCode, string> = {
+  disabled: 'AI helpers are off in TameerBook Settings.',
+  offline: 'The phone running TameerBook is offline right now. Try again in a while.',
+  timeout: 'The assistant took too long. Try again.',
+  noProvider: 'No AI key is set in TameerBook Settings.',
+  noVoice: 'Voice is not available here.',
+  quota: 'The AI limit is used up for now. Try again in a few minutes.',
+  badkey: 'The AI key was rejected. Check TameerBook Settings.',
+  unparseable: 'Did not understand that. Try shorter words.',
+  failed: 'Could not get an answer. Try again.',
+};
+
+/**
+ * What a draft needs that the WhatsApp user could not tap: the usual account
+ * (memory) or the first one; the only project when there is one; the worker's
+ * participation with a balance; the plot it named.
+ */
+export async function autoChoices(r: ResolvedDraft, world: World, memory: { defaults: { account?: string; project?: string } }): Promise<DraftChoices> {
+  const byName = (name: string | undefined, list: readonly { id: string; name: string }[]) => (name ? list.find((x) => x.name.toLowerCase() === name.toLowerCase())?.id ?? null : null);
+  const accountId = r.account?.id ?? byName(memory.defaults.account, world.accounts) ?? world.accounts[0]?.id ?? null;
+  const projectId = r.project?.id ?? (world.projects.length === 1 ? world.projects[0].id : byName(memory.defaults.project, world.projects));
+  let projectLaborerId: string | null = null;
+  if (r.draft.kind === 'payWorker' && r.worker) {
+    const candidates: { id: string; balance: number; projectId: string }[] = [];
+    for (const p of world.projects) {
+      const pls = await listProjectLaborers(p.id).catch(() => []);
+      for (const pl of pls) if (pl.laborer.id === r.worker.id) candidates.push({ id: pl.projectLaborer.id, balance: pl.balance.balance, projectId: p.id });
+    }
+    const preferred = projectId ? candidates.find((c) => c.projectId === projectId) : undefined;
+    projectLaborerId = (preferred ?? candidates.sort((a, b) => b.balance - a.balance)[0])?.id ?? null;
+  }
+  return { accountId, projectId, projectLaborerId, plotId: r.plot?.id ?? null };
+}
+
+/** Run every draft of a confirmed action; each line reports one step. */
+async function applyPending(a: PendingAction): Promise<string> {
+  const [world, memory0] = await Promise.all([buildWorld(), loadMemory()]);
+  let memory = memory0;
+  const lines: string[] = [];
+  let poId: string | null = null;
+  for (const [i, r] of a.drafts.entries()) {
+    try {
+      const choices = { ...(await autoChoices(r, world, memory)), poId };
+      const applied = await applyDraft(r, choices);
+      if (applied.target && 'poId' in applied.target) poId = applied.target.poId;
+      memory = noteAccepted(memory, r, { account: world.accounts.find((x) => x.id === choices.accountId)?.name, project: world.projects.find((x) => x.id === choices.projectId)?.name });
+      lines.push(`✓ ${a.drafts.length > 1 ? `${i + 1}. ` : ''}${applied.message}`);
+    } catch (e) {
+      const msg = e instanceof Error ? e.message : 'failed';
+      lines.push(`✗ ${a.drafts.length > 1 ? `${i + 1}. ` : ''}${msg}`);
+    }
+  }
+  if (memory !== memory0) void saveMemory(memory).catch(swallow('whatsapp:memory'));
+  return lines.join('\n');
+}
+
+/** A read card as plain lines, for figures the model's sentence left out. */
+function cardLines(c: Answer): string[] {
+  const out: string[] = [];
+  const head = [c.title, c.headline].filter(Boolean).join(': ');
+  if (head) out.push(`*${head}*`);
+  if (c.sub) out.push(c.sub);
+  const rows = c.list ? c.list.slice(0, 6).map((r) => `• ${r.title}${r.subtitle ? ` · ${r.subtitle}` : ''}`) : c.rows.slice(0, 6).map((r) => `• ${r.title}: ${formatRupees(r.amount)}`);
+  out.push(...rows);
+  const total = (c.list ?? c.rows).length;
+  if (total > 6) out.push(`• +${total - 6}`);
+  return out;
+}
+
+/** Recent turns of this participant as model history (oldest first). */
+function historyFor(phone: string): AiChatMessage[] {
+  const turns = useWhatsAppStore.getState().turnsFor(phone).slice(-10);
+  const out: AiChatMessage[] = [];
+  for (const t of turns) {
+    const content = t.text.slice(0, 600);
+    if (!content.trim()) continue;
+    out.push(t.role === 'user' ? { role: 'user', content } : { role: 'assistant', content });
+  }
+  while (out.length && out[0].role !== 'user') out.shift();
+  return out;
+}
+
+/** Handle one message and return the reply text (already WhatsApp-formatted, never empty). */
+export async function handleInbound(msg: InboundMessage): Promise<string> {
+  const store = useWhatsAppStore.getState();
+  const cfg = store.config;
+  if (!isAdminParticipant(cfg, msg.from)) return DENIED;
+  // Pair with the participant id Meta gave us, so the whitelist keeps matching.
+  if (cfg.lastActiveUserId !== msg.from) store.setConfig({ lastActiveUserId: msg.from });
+
+  const at = new Date().toISOString();
+  const remember = (role: WaTurn['role'], text: string) => useWhatsAppStore.getState().appendTurn(msg.from, { role, text, at });
+  remember('user', msg.body);
+
+  const reply = await respond(msg);
+  const out = clampWhatsApp(reply);
+  remember('assistant', out);
+  return out;
+}
+
+async function respond(msg: InboundMessage): Promise<string> {
+  const phone = msg.from;
+  const cmd = parseCommand(msg.body);
+  if (cmd) {
+    const a = cmd.kind === 'confirm' || cmd.kind === 'cancel' ? pending.get(cmd.id) : latestPending(phone);
+    if (cmd.kind === 'confirm' || cmd.kind === 'confirmLatest') {
+      if (!a || a.phone !== phone) return cmd.kind === 'confirm' ? `${cmd.id} was not found or has expired.` : 'Nothing is waiting to be saved.';
+      pending.delete(a.id);
+      return applyPending(a);
+    }
+    if (!a || a.phone !== phone) return cmd.kind === 'cancel' ? `${cmd.id} was not found or has already expired.` : 'Nothing is waiting to be saved.';
+    pending.delete(a.id);
+    return a.lang === 'ur' ? 'چھوڑ دیا۔' : a.lang === 'roman' ? 'Chhor diya.' : 'Dropped.';
+  }
+
+  const text = resolveNumberedReply(msg.body, lastOptions.get(phone));
+  lastOptions.delete(phone);
+  try {
+    const transport = getAiTransport();
+    const [world, memory] = await Promise.all([buildWorld(), loadMemory()]);
+    const settings = useSettingsStore.getState();
+    const guess = detectLanguage(text);
+    const language = decideReplyLanguage({ text, setting: settings.aiReplyLanguage, appLanguage: settings.language, recent: memory.langs });
+    const r = await runAgent(text, {
+      transport,
+      world,
+      runIntent,
+      history: historyFor(phone).slice(0, -1),
+      prompt: { language, memory: memoryBlock(memory), channel: 'whatsapp' },
+    });
+
+    let mem = noteLanguage(memory, guess.strong ? guess.language : null);
+    for (const f of r.learned) mem = addFact(mem, f, todayISO());
+    if (mem !== memory) void saveMemory(mem).catch(swallow('whatsapp:memory'));
+
+    const parts: string[] = [];
+    if (r.text) parts.push(toWhatsAppText(r.text));
+    // Figures the sentence did not carry: restate the card headline and top rows.
+    for (const c of r.cards) {
+      if (c.headline && r.text.includes(c.headline)) continue;
+      if (c.notFound) continue;
+      parts.push(cardLines(c).join('\n'));
+    }
+    if (r.options.length) {
+      lastOptions.set(phone, r.options);
+      parts.push(optionsBlock(r.options));
+    }
+    if (r.drafts.length) {
+      const cfg = useWhatsAppStore.getState().config;
+      if (cfg.requireConfirmation) {
+        const id = newActionId();
+        pending.set(id, { id, phone, drafts: r.drafts, lang: language, createdAt: Date.now() });
+        parts.push(confirmFooter(id, language));
+      } else {
+        parts.push(await applyPending({ id: 'now', phone, drafts: r.drafts, lang: language, createdAt: Date.now() }));
+      }
+    }
+    if (r.open && parts.length === 0) parts.push('That opens a screen in the app; ask me for the figures here instead.');
+    return parts.join('\n\n').trim() || ERRORS.unparseable;
+  } catch (e) {
+    const code: AiErrorCode = isAiError(e) ? e.code : 'failed';
+    if (code === 'failed') reportError('whatsapp:respond', e);
+    return ERRORS[code];
+  }
+}
diff --git a/src/modules/whatsapp/briefings.ts b/src/modules/whatsapp/briefings.ts
new file mode 100644
index 0000000..1a7c800
--- /dev/null
+++ b/src/modules/whatsapp/briefings.ts
@@ -0,0 +1,121 @@
+import { listAccountsWithBalance, listInsights, listProjectSummaries, listPurchaseOrders, listUdhaar } from '@/db';
+import { useSettingsStore } from '@/stores/useSettingsStore';
+import { formatRupees } from '@/utils/money';
+
+import { toWhatsAppText } from './format';
+
+/**
+ * SCHEDULED MESSAGES — the four proactive texts the agent sends on its own,
+ * built straight from the repositories (no model call, no tokens). Each
+ * returns null when there is nothing worth saying, except the morning
+ * report, which always goes out.
+ */
+
+const rs = formatRupees;
+
+/** Labels in the app's UI language (Urdu script or English). */
+function labels() {
+  const ur = useSettingsStore.getState().language === 'ur';
+  return ur
+    ? {
+        morning: 'صبح کی رپورٹ',
+        cash: 'اکاؤنٹس',
+        projects: 'چلتے پروجیکٹ',
+        cost: 'خرچ',
+        orders: 'ادھورے آرڈر',
+        toPay: 'باقی',
+        workers: 'مزدوروں کے پیسے',
+        days: 'دن',
+        none: 'کچھ نہیں',
+        wagesTitle: 'مزدوری کی ادائیگی',
+        wagesLine: (n: number, d: number) => `${n} مزدوروں کے پیسے ${d}+ دن سے باقی ہیں:`,
+        udhaarTitle: 'ادھار کی یاد دہانی',
+        given: 'لینے ہیں',
+        taken: 'دینے ہیں',
+        stuckTitle: 'ڈلیوری رکی ہوئی',
+        stuckLine: (n: number, d: number) => `${n} آرڈر ${d}+ دن سے ڈلیور نہیں ہوئے:`,
+        more: (n: number) => `اور ${n} مزید`,
+        footer: 'کچھ پوچھنا ہو تو یہیں لکھیں۔',
+      }
+    : {
+        morning: 'Subah ki report',
+        cash: 'Accounts',
+        projects: 'Active projects',
+        cost: 'cost',
+        orders: 'Open orders',
+        toPay: 'to pay',
+        workers: 'Workers to pay',
+        days: 'days',
+        none: 'nothing',
+        wagesTitle: 'Mazdoor payment alert',
+        wagesLine: (n: number, d: number) => `${n} worker(s) unpaid for ${d}+ days:`,
+        udhaarTitle: 'Udhaar reminder',
+        given: 'to collect',
+        taken: 'to return',
+        stuckTitle: 'Stuck orders',
+        stuckLine: (n: number, d: number) => `${n} order(s) undelivered for ${d}+ days:`,
+        more: (n: number) => `and ${n} more`,
+        footer: 'Reply here to ask anything.',
+      };
+}
+
+const today = (): string => new Date().toISOString().slice(0, 10);
+
+export async function morningBriefing(): Promise<string> {
+  const L = labels();
+  const [accounts, projects, pos, insights] = await Promise.all([listAccountsWithBalance(), listProjectSummaries(), listPurchaseOrders(), listInsights(today())]);
+  const lines: string[] = [`**${L.morning}** · ${new Date().toLocaleDateString('en-GB')}`, ''];
+
+  const total = accounts.reduce((s, a) => s + a.balance, 0);
+  lines.push(`**${L.cash}: ${rs(total)}**`);
+  for (const a of accounts.slice(0, 5)) lines.push(`- ${a.name}: ${rs(a.balance)}`);
+  lines.push('');
+
+  const active = projects.filter((p) => p.project.status === 'ACTIVE');
+  lines.push(`**${L.projects}: ${active.length}**`);
+  for (const p of active.slice(0, 5)) lines.push(`- ${p.project.name}: ${rs(p.cost.totalCost)} ${L.cost}`);
+  if (active.length > 5) lines.push(`- ${L.more(active.length - 5)}`);
+  lines.push('');
+
+  const open = pos.filter((p) => p.status === 'OPEN' && (p.payRemaining >= 1 || !p.fullyReceived));
+  const owed = open.reduce((s, p) => s + p.payRemaining, 0);
+  lines.push(`**${L.orders}: ${open.length}** · ${rs(owed)} ${L.toPay}`);
+  for (const p of open.slice(0, 4)) lines.push(`- ${p.poNumber} ${p.supplierName ?? ''}: ${rs(p.payRemaining)} ${L.toPay}`);
+  lines.push('');
+
+  const workers = insights.filter((i) => i.kind === 'workerOwed');
+  const wagesDue = workers.reduce((s, i) => s + (i.amount ?? 0), 0);
+  lines.push(`**${L.workers}: ${workers.length ? rs(wagesDue) : L.none}**`);
+  for (const w of workers.slice(0, 5)) lines.push(`- ${w.subject}: ${rs(w.amount ?? 0)} · ${w.days ?? 0} ${L.days}`);
+  lines.push('', `_${L.footer}_`);
+  return toWhatsAppText(lines.join('\n'));
+}
+
+export async function wagesAlert(minDays: number): Promise<string | null> {
+  const L = labels();
+  const workers = (await listInsights(today())).filter((i) => i.kind === 'workerOwed' && (i.days ?? 0) >= minDays);
+  if (workers.length === 0) return null;
+  const lines = [`**${L.wagesTitle}**`, L.wagesLine(workers.length, minDays), ''];
+  for (const w of workers.slice(0, 8)) lines.push(`- ${w.subject}: **${rs(w.amount ?? 0)}** · ${w.days ?? 0} ${L.days}`);
+  if (workers.length > 8) lines.push(`- ${L.more(workers.length - 8)}`);
+  return toWhatsAppText(lines.join('\n'));
+}
+
+export async function udhaarReminder(): Promise<string | null> {
+  const L = labels();
+  const open = (await listUdhaar('OPEN')).filter((u) => u.balance > 0);
+  if (open.length === 0) return null;
+  const lines = [`**${L.udhaarTitle}**`, ''];
+  for (const u of open.slice(0, 10)) lines.push(`- ${u.person_name}: **${rs(u.balance)}** ${u.direction === 'GIVEN' ? L.given : L.taken}`);
+  if (open.length > 10) lines.push(`- ${L.more(open.length - 10)}`);
+  return toWhatsAppText(lines.join('\n'));
+}
+
+export async function stuckOrdersAlert(minDays: number): Promise<string | null> {
+  const L = labels();
+  const stuck = (await listInsights(today())).filter((i) => i.kind === 'poUndelivered' && (i.days ?? 0) >= minDays);
+  if (stuck.length === 0) return null;
+  const lines = [`**${L.stuckTitle}**`, L.stuckLine(stuck.length, minDays), ''];
+  for (const s of stuck.slice(0, 8)) lines.push(`- ${s.subject}: ${s.days ?? 0} ${L.days}${s.amount ? ` · ${rs(s.amount)}` : ''}`);
+  return toWhatsAppText(lines.join('\n'));
+}

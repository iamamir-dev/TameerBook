+import { useNavigation } from '@react-navigation/native';
+import type { NativeStackNavigationProp } from '@react-navigation/native-stack';
+import React, { useEffect, useState } from 'react';
+import { Alert, StyleSheet, View } from 'react-native';
+
+import { FloatingLabelInput } from '@/components/FloatingLabelInput';
+import { SettingsGroup, SettingsPage, SettingsRow } from '@/components/settings';
+import { AppButton, AppIcon, AppSheet, AppText, AppToggle, SelectSheet, type IconKey, type SelectOption } from '@/components/ui';
+import { useTranslation, type TranslationKey } from '@/i18n';
+import type { RootStackParamList } from '@/navigation/types';
+import { useSettingsStore } from '@/stores/useSettingsStore';
+import { useTheme } from '@/theme';
+import type { Theme } from '@/theme/theme';
+import { formatTime } from '@/utils/date';
+
+import { parseAdminPhones } from '../access';
+import { parseClock } from '../format';
+import { pendingCount } from '../handle';
+import { runSchedules, sendTestMessage, syncWhatsAppAgent } from '../service';
+import { useWhatsAppStore, type WaConfig } from '../store';
+
+type Nav = NativeStackNavigationProp<RootStackParamList>;
+type Job = 'briefing' | 'wages' | 'udhaar' | 'orders';
+
+type Edit = { kind: 'key' } | { kind: 'phones' } | { kind: 'time'; job: Job } | { kind: 'days'; job: 'wages' | 'orders' };
+
+const WEEKDAYS_EN = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
+const WEEKDAYS_UR = ['اتوار', 'پیر', 'منگل', 'بدھ', 'جمعرات', 'جمعہ', 'ہفتہ'];
+const EDIT_LABEL: Record<Edit['kind'], TranslationKey> = { key: 'waKeyLabel', phones: 'waAdminPhones', time: 'waTime', days: 'waMinDays' };
+const JOBS: { job: Job; labelKey: TranslationKey }[] = [
+  { job: 'briefing', labelKey: 'waBriefing' },
+  { job: 'wages', labelKey: 'waWages' },
+  { job: 'udhaar', labelKey: 'waUdhaar' },
+  { job: 'orders', labelKey: 'waOrders' },
+];
+
+/**
+ * The WhatsApp agent's settings page: status, the Cloud Agent key, who may
+ * use it, which scheduled messages it sends and when, and the recent
+ * conversation. The poller itself lives in `service.ts`.
+ */
+export function WhatsAppAgentScreen(): React.JSX.Element {
+  const theme = useTheme();
+  const { t, language } = useTranslation();
+  const navigation = useNavigation<Nav>();
+  const styles = makeStyles(theme);
+
+  const config = useWhatsAppStore((s) => s.config);
+  const status = useWhatsAppStore((s) => s.status);
+  const histories = useWhatsAppStore((s) => s.histories);
+  const setConfig = useWhatsAppStore((s) => s.setConfig);
+  const clearHistory = useWhatsAppStore((s) => s.clearHistory);
+  const aiEnabled = useSettingsStore((s) => s.aiEnabled);
+
+  const [edit, setEdit] = useState<Edit | null>(null);
+  const [draft, setDraft] = useState('');
+  const [weekdaySheet, setWeekdaySheet] = useState(false);
+  const [busy, setBusy] = useState<string | null>(null);
+  const [note, setNote] = useState<string | null>(null);
+
+  // The poller follows the settings; keep it in the right state while this page is open.
+  useEffect(() => {
+    syncWhatsAppAgent();
+  }, [config.enabled, config.apiKey, aiEnabled]);
+
+  const openEdit = (e: Edit) => {
+    setDraft(e.kind === 'key' ? config.apiKey : e.kind === 'phones' ? config.adminPhones.join(', ') : e.kind === 'time' ? config[e.job].time : String(config[e.job].minDays));
+    setEdit(e);
+  };
+  const saveEdit = () => {
+    if (!edit) return;
+    const v = draft.trim();
+    if (edit.kind === 'key') setConfig({ apiKey: v });
+    else if (edit.kind === 'phones') setConfig({ adminPhones: parseAdminPhones(v) });
+    else if (edit.kind === 'time') {
+      if (parseClock(v) === null) {
+        Alert.alert(t('waTime'), '09:00');
+        return;
+      }
+      setConfig({ [edit.job]: { ...config[edit.job], time: v } } as Partial<WaConfig>);
+    } else {
+      setConfig({ [edit.job]: { ...config[edit.job], minDays: Math.max(1, Math.min(90, Math.round(Number(v) || 1))) } } as Partial<WaConfig>);
+    }
+    setEdit(null);
+  };
+
+  const act = (key: string, fn: () => Promise<string | null | void>) => () => {
+    if (busy) return;
+    setBusy(key);
+    setNote(null);
+    fn()
+      .then((r) => setNote(r === null ? t('waNothingToSend') : t('waSent')))
+      .catch((e: unknown) => Alert.alert(t('waLastError'), e instanceof Error ? e.message : String(e)))
+      .finally(() => setBusy(null));
+  };
+
+  const statusLine = !aiEnabled ? t('waStatusNeedsAi') : !config.apiKey ? t('waStatusNeedsKey') : status.running ? t('waStatusRunning') : t('waStatusStopped');
+  const weekdays = language === 'ur' ? WEEKDAYS_UR : WEEKDAYS_EN;
+  const weekdayOptions: SelectOption[] = weekdays.map((d, i) => ({ id: String(i), label: d, icon: 'today' as IconKey }));
+  const turns = Object.entries(histories)
+    .flatMap(([phone, list]) => list.map((x) => ({ ...x, phone })))
+    .sort((a, b) => a.at.localeCompare(b.at))
+    .slice(-14);
+  const check = <AppIcon name="checkCircle" size={20} color="accent" />;
+
+  return (
+    <SettingsPage
+      title={t('waAgentLabel')}
+      onBack={() => navigation.goBack()}
+      overlays={
+        <>
+          <AppSheet visible={edit !== null} onClose={() => setEdit(null)} title={edit ? t(EDIT_LABEL[edit.kind]) : ''} footer={<AppButton label={t('save')} icon="check" onPress={saveEdit} />}>
+            <FloatingLabelInput
+              label={edit ? t(EDIT_LABEL[edit.kind]) : ''}
+              value={draft}
+              onChangeText={setDraft}
+              keyboardType={edit?.kind === 'days' ? 'number-pad' : edit?.kind === 'time' ? 'numbers-and-punctuation' : 'default'}
+              multiline={edit?.kind === 'phones'}
+              hint={edit?.kind === 'key' ? t('waKeyHint') : edit?.kind === 'phones' ? t('waAdminPhonesHint') : undefined}
+            />
+          </AppSheet>
+          <SelectSheet
+            visible={weekdaySheet}
+            onClose={() => setWeekdaySheet(false)}
+            options={weekdayOptions}
+            selectedId={String(config.udhaar.weekday)}
+            title={t('waWeekday')}
+            searchable={false}
+            onSelect={(o) => {
+              setConfig({ udhaar: { ...config.udhaar, weekday: Number(o.id) } });
+              setWeekdaySheet(false);
+            }}
+          />
+        </>
+      }
+    >
+      {/* Status */}
+      <SettingsGroup header={t('hdrStatus')} footer={t('waRunsWhileOpen')}>
+        <SettingsRow title={t('waEnabled')} subtitle={statusLine} trailing={<AppToggle value={config.enabled} onValueChange={(v) => setConfig({ enabled: v })} accessibilityLabel={t('waEnabled')} />} />
+        <View style={styles.stats}>
+          <Stat label={t('waLastPoll')} value={status.lastPollAt ? formatTime(status.lastPollAt) : '–'} />
+          <Stat label={t('waMessagesToday')} value={String(status.messagesToday)} />
+          <Stat label={t('waPending')} value={String(pendingCount())} />
+        </View>
+        {status.lastError ? <SettingsRow title={t('waLastError')} subtitle={status.lastError} danger /> : null}
+      </SettingsGroup>
+
+      {/* Connection */}
+      <SettingsGroup header={t('hdrConnection')} footer={note ?? undefined}>
+        <SettingsRow title={t('waKeyLabel')} subtitle={config.apiKey ? undefined : t('waKeyHint')} trailing={config.apiKey ? check : undefined} onPress={() => openEdit({ kind: 'key' })} />
+        <SettingsRow title={t('waTestMessage')} subtitle={busy === 'test' ? '…' : undefined} onPress={act('test', async () => {
+          if (!config.adminPhones.length && !config.lastActiveUserId) throw new Error(t('waNoTarget'));
+          await sendTestMessage();
+        })} />
+      </SettingsGroup>
+
+      {/* Access */}
+      <SettingsGroup header={t('hdrAccess')} footer={t('waAdminPhonesHint')}>
+        <SettingsRow title={t('waAdminPhones')} subtitle={config.adminPhones.length ? config.adminPhones.join(', ') : undefined} onPress={() => openEdit({ kind: 'phones' })} />
+        {config.lastActiveUserId ? <SettingsRow title={t('waPaired')} subtitle={config.lastActiveUserId} value={t('waUnpair')} onPress={() => setConfig({ lastActiveUserId: null })} /> : null}
+        <SettingsRow title={t('waRequireConfirm')} subtitle={t('waRequireConfirmHint')} trailing={<AppToggle value={config.requireConfirmation} onValueChange={(v) => setConfig({ requireConfirmation: v })} accessibilityLabel={t('waRequireConfirm')} />} />
+      </SettingsGroup>
+
+      {/* Scheduled messages: one group per job, WhatsApp-style toggle + detail rows */}
+      {JOBS.map(({ job, labelKey }) => {
+        const s = config[job];
+        const detail = [s.time, job === 'udhaar' ? weekdays[config.udhaar.weekday] : null, job === 'wages' || job === 'orders' ? `${config[job].minDays} ${t('waMinDays').toLowerCase()}` : null].filter(Boolean).join(' · ');
+        return (
+          <SettingsGroup key={job} header={job === 'briefing' ? t('waReminders') : undefined}>
+            <SettingsRow title={t(labelKey)} subtitle={detail} trailing={<AppToggle value={s.enabled} onValueChange={(v) => setConfig({ [job]: { ...s, enabled: v } } as Partial<WaConfig>)} accessibilityLabel={t(labelKey)} />} />
+            {s.enabled ? <SettingsRow title={t('waTime')} value={s.time} onPress={() => openEdit({ kind: 'time', job })} /> : null}
+            {s.enabled && (job === 'wages' || job === 'orders') ? <SettingsRow title={t('waMinDays')} value={String(config[job].minDays)} onPress={() => openEdit({ kind: 'days', job })} /> : null}
+            {s.enabled && job === 'udhaar' ? <SettingsRow title={t('waWeekday')} value={weekdays[config.udhaar.weekday] ?? ''} onPress={() => setWeekdaySheet(true)} /> : null}
+            {s.enabled ? <SettingsRow title={t('waSendNow')} subtitle={busy === job ? '…' : undefined} onPress={act(job, () => runSchedules(job))} /> : null}
+          </SettingsGroup>
+        );
+      })}
+
+      {/* Conversation */}
+      <SettingsGroup header={t('hdrConversation')}>
+        {turns.length === 0 ? (
+          <SettingsRow title={t('waNoTurns')} />
+        ) : (
+          <View style={styles.turns}>
+            {turns.map((x, i) => (
+              <View key={`${x.at}-${i}`} style={[styles.bubble, x.role === 'user' ? styles.bubbleUser : styles.bubbleAgent]}>
+                <AppText size="xs" color="textSecondary">
+                  {x.role === 'user' ? x.phone : 'TameerBook'} · {formatTime(x.at)}
+                </AppText>
+                <AppText size="sm">{x.text}</AppText>
+              </View>
+            ))}
+          </View>
+        )}
+        {turns.length ? (
+          <SettingsRow
+            title={t('waClearHistory')}
+            danger
+            onPress={() => Alert.alert(t('waClearHistory'), undefined, [{ text: t('cancel'), style: 'cancel' }, { text: t('delete'), style: 'destructive', onPress: clearHistory }])}
+          />
+        ) : null}
+      </SettingsGroup>
+    </SettingsPage>
+  );
+}
+
+function Stat({ label, value }: { label: string; value: string }): React.JSX.Element {
+  const theme = useTheme();
+  const styles = makeStyles(theme);
+  return (
+    <View style={styles.stat}>
+      <AppText size="xs" color="textSecondary">
+        {label}
+      </AppText>
+      <AppText size="md" weight="semibold">
+        {value}
+      </AppText>
+    </View>
+  );
+}
+
+const makeStyles = (theme: Theme) =>
+  StyleSheet.create({
+    stats: { flexDirection: 'row', justifyContent: 'space-between', paddingVertical: theme.spacing.sm, gap: theme.spacing.sm },
+    stat: { flex: 1, gap: 2 },
+    turns: { gap: theme.spacing.sm, paddingVertical: theme.spacing.sm },
+    bubble: { padding: theme.spacing.sm, borderRadius: theme.radius.md, gap: 2 },
+    bubbleUser: { backgroundColor: theme.colors.primarySoft },
+    bubbleAgent: { backgroundColor: theme.colors.accentSoft },
+  });
+

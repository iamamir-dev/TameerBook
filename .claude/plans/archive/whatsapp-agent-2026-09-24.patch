+import { describe, expect, it } from 'vitest';
+
+import { isAdminParticipant, parseAdminPhones } from './access';
+
+describe('isAdminParticipant', () => {
+  it('rejects everyone when the list is empty', () => {
+    expect(isAdminParticipant({ adminPhones: [] }, 'user:1')).toBe(false);
+  });
+  it('matches the phone, the bare id and the digits', () => {
+    expect(isAdminParticipant({ adminPhones: ['+923001234567'] }, '923001234567')).toBe(true);
+    expect(isAdminParticipant({ adminPhones: ['user:114937619824772'] }, 'user:114937619824772')).toBe(true);
+    expect(isAdminParticipant({ adminPhones: ['114937619824772'] }, 'user:114937619824772')).toBe(true);
+  });
+  it('matches a local number against the international one by suffix', () => {
+    // Two numbers listed, so the one-number auto-bind rule stays out of the way.
+    expect(isAdminParticipant({ adminPhones: ['03001234567', '03007654321'] }, '923001234567')).toBe(true);
+    expect(isAdminParticipant({ adminPhones: ['03001234567', '03007654321'] }, '923009999999')).toBe(false);
+  });
+  it('trusts the paired participant', () => {
+    expect(isAdminParticipant({ adminPhones: ['03001234567'], lastActiveUserId: 'user:555' }, 'user:555')).toBe(true);
+  });
+  it('auto-binds only while nobody is paired and exactly one plain number is listed', () => {
+    expect(isAdminParticipant({ adminPhones: ['03001234567'] }, 'user:555')).toBe(true);
+    expect(isAdminParticipant({ adminPhones: ['03001234567'], lastActiveUserId: 'user:444' }, 'user:555')).toBe(false);
+    expect(isAdminParticipant({ adminPhones: ['03001234567', '03007654321'] }, 'user:555')).toBe(false);
+  });
+});
+
+describe('parseAdminPhones', () => {
+  it('splits on commas and newlines and dedupes', () => {
+    expect(parseAdminPhones('03001234567, user:555\n03001234567;')).toEqual(['03001234567', 'user:555']);
+  });
+});
diff --git a/src/modules/whatsapp/api.ts b/src/modules/whatsapp/api.ts
new file mode 100644
index 0000000..6d2cc60
--- /dev/null
+++ b/src/modules/whatsapp/api.ts
@@ -0,0 +1,87 @@
+import { AiError } from '@/ai';
+
+/**
+ * WHATSAPP CLOUD AGENT API — the same three calls SubscribAI's service
+ * makes: long-poll for inbound messages, send a text, mark a message read
+ * (which also shows the typing indicator). Bearer key from Settings.
+ */
+export const WHATSAPP_AGENT_BASE = 'https://api.whatsapp.com/agent/v1';
+
+export interface InboundMessage {
+  id: string;
+  from: string;
+  body: string;
+}
+
+export interface PollResult {
+  messages: InboundMessage[];
+  nextOffset: number | undefined;
+}
+
+async function request(key: string, path: string, init: RequestInit, timeoutMs: number): Promise<Response> {
+  const ctrl = new AbortController();
+  const timer = setTimeout(() => ctrl.abort(), timeoutMs);
+  try {
+    return await fetch(`${WHATSAPP_AGENT_BASE}${path}`, {
+      ...init,
+      headers: { Authorization: `Bearer ${key}`, 'Content-Type': 'application/json', ...(init.headers ?? {}) },
+      signal: ctrl.signal,
+    });
+  } catch (e) {
+    if (ctrl.signal.aborted) throw new AiError('timeout', `${timeoutMs}ms`);
+    throw new AiError('offline', e instanceof Error ? e.message : undefined);
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+/** Long-poll for new text messages. 204 = nothing new; 409 = another poller holds the lock. */
+export async function pollUpdates(key: string, offset: number | undefined): Promise<PollResult | null> {
+  const params = new URLSearchParams({ limit: '50', timeout: '10' });
+  if (offset !== undefined) params.set('offset', String(offset));
+  const res = await request(key, `/updates?${params.toString()}`, { method: 'GET' }, 25_000);
+  if (res.status === 204 || res.status === 409) return null;
+  if (res.status === 401 || res.status === 403) throw new AiError('badkey', 'whatsapp key rejected');
+  if (res.status === 429) throw new AiError('quota', 'whatsapp rate limit');
+  if (!res.ok) throw new AiError('failed', `whatsapp poll ${res.status}`);
+  const data = (await res.json()) as { entry?: { changes?: { value?: { messages?: { id?: string; from?: string; type?: string; text?: { body?: string } }[] } }[] }[]; next_offset?: number };
+  const messages: InboundMessage[] = [];
+  for (const entry of data.entry ?? []) {
+    for (const change of entry.changes ?? []) {
+      for (const m of change.value?.messages ?? []) {
+        if (m.type === 'text' && m.text?.body && m.id && m.from) messages.push({ id: m.id, from: m.from, body: m.text.body });
+      }
+    }
+  }
+  return { messages, nextOffset: typeof data.next_offset === 'number' ? data.next_offset : offset };
+}
+
+/**
+ * Send a text. `to` is a participant id (`user:…`) or a phone; a plain phone
+ * is wrapped as `user:<phone>`. Replies quote the inbound message on the
+ * first attempt only, so an expired context never blocks delivery.
+ */
+export async function sendText(key: string, to: string, body: string, replyToId?: string): Promise<void> {
+  const recipient = /^(user|agent):/.test(to) ? to : `user:${to.replace(/^\+/, '')}`;
+  let lastStatus = 0;
+  for (let attempt = 0; attempt < 3; attempt++) {
+    const payload: Record<string, unknown> = { messaging_product: 'whatsapp', to: recipient, type: 'text', text: { body } };
+    if (replyToId && attempt === 0) payload.context = { message_id: replyToId };
+    const res = await request(key, '/messages', { method: 'POST', body: JSON.stringify(payload) }, 15_000);
+    if (res.ok) return;
+    lastStatus = res.status;
+    if (res.status === 401 || res.status === 403) throw new AiError('badkey', 'whatsapp key rejected');
+    await new Promise((r) => setTimeout(r, 1000 * (attempt + 1)));
+  }
+  throw new AiError('failed', `whatsapp send ${lastStatus}`);
+}
+
+/** Read receipt + typing indicator; best effort. */
+export async function markRead(key: string, messageId: string): Promise<void> {
+  await request(
+    key,
+    '/statuses',
+    { method: 'POST', body: JSON.stringify({ messaging_product: 'whatsapp', status: 'read', message_id: messageId, typing_indicator: { type: 'text' } }) },
+    8_000
+  ).catch(() => undefined);
+}

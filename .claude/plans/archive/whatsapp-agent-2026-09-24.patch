+import { AppState, type AppStateStatus } from 'react-native';
+
+import { isAiError } from '@/ai';
+import { useCompanyStore } from '@/stores/useCompanyStore';
+import { useSettingsStore } from '@/stores/useSettingsStore';
+import { reportError } from '@/utils/log';
+
+import { markRead, pollUpdates, sendText } from './api';
+import { morningBriefing, stuckOrdersAlert, udhaarReminder, wagesAlert } from './briefings';
+import { isDailyDue, localDay } from './format';
+import { handleInbound } from './handle';
+import { useWhatsAppStore } from './store';
+
+/**
+ * THE AGENT'S HEARTBEAT. While the app is in the foreground and the agent is
+ * switched on, this long-polls the WhatsApp Cloud Agent API for messages and
+ * answers each one, and once a minute checks whether a scheduled message is
+ * due. Everything runs on the phone: the ledger is here, so the answers are.
+ *
+ * Lifecycle: `syncWhatsAppAgent()` is idempotent and is called after boot and
+ * whenever the agent settings, the AI settings or the app state change.
+ */
+
+const POLL_GAP_MS = 1_500;
+const ERROR_BACKOFF_MS = 15_000;
+const TICK_MS = 60_000;
+
+let pollTimer: ReturnType<typeof setTimeout> | null = null;
+let tickTimer: ReturnType<typeof setInterval> | null = null;
+let polling = false;
+let stopped = true;
+let wired = false;
+
+const store = () => useWhatsAppStore.getState();
+
+/** Everything a running agent needs: switched on, a key, AI on, a company open, app in front. */
+function shouldRun(): boolean {
+  const cfg = store().config;
+  const s = useSettingsStore.getState();
+  return cfg.enabled && !!cfg.apiKey && s.aiEnabled && !!useCompanyStore.getState().activeCompanyId && AppState.currentState === 'active';
+}
+
+/** Where proactive messages go: the paired participant, else the first allowed number. */
+export function targetParticipant(): string | null {
+  const cfg = store().config;
+  return cfg.lastActiveUserId ?? cfg.adminPhones[0] ?? null;
+}
+
+async function pollOnce(): Promise<number> {
+  const cfg = store().config;
+  const res = await pollUpdates(cfg.apiKey, store().nextOffset);
+  store().setStatus({ lastPollAt: new Date().toISOString(), lastError: null });
+  if (!res) return POLL_GAP_MS;
+  if (res.nextOffset !== undefined) store().setOffset(res.nextOffset);
+  for (const msg of res.messages) {
+    if (stopped) break;
+    void markRead(cfg.apiKey, msg.id);
+    let reply: string;
+    try {
+      reply = await handleInbound(msg);
+    } catch (e) {
+      reportError('whatsapp:handle', e);
+      reply = 'Something went wrong on the phone. Try again.';
+    }
+    try {
+      await sendText(cfg.apiKey, msg.from, reply, msg.id);
+    } catch (e) {
+      reportError('whatsapp:send', e);
+      store().setStatus({ lastError: e instanceof Error ? e.message : 'send failed' });
+    }
+  }
+  return res.messages.length ? 200 : POLL_GAP_MS;
+}
+
+function scheduleNext(ms: number): void {
+  if (pollTimer) clearTimeout(pollTimer);
+  pollTimer = setTimeout(() => void loop(), ms);
+}
+
+async function loop(): Promise<void> {
+  if (stopped || polling) return;
+  if (!shouldRun()) {
+    stop();
+    return;
+  }
+  polling = true;
+  let delay = POLL_GAP_MS;
+  try {
+    delay = await pollOnce();
+  } catch (e) {
+    const code = isAiError(e) ? e.code : 'failed';
+    store().setStatus({ lastError: e instanceof Error ? e.message.slice(0, 120) : 'poll failed' });
+    // A rejected key will not fix itself: stop and let the screen show the error.
+    if (code === 'badkey') {
+      polling = false;
+      stop();
+      return;
+    }
+    delay = ERROR_BACKOFF_MS;
+  } finally {
+    polling = false;
+  }
+  if (!stopped) scheduleNext(delay);
+}
+
+/** Send whichever scheduled messages are due; also used by the "send now" buttons. */
+export async function runSchedules(force?: 'briefing' | 'wages' | 'udhaar' | 'orders'): Promise<string | null> {
+  const cfg = store().config;
+  const to = targetParticipant();
+  if (!to || !cfg.apiKey) return null;
+  const now = new Date();
+  const day = localDay(now);
+  const runs = store().lastRuns;
+  const jobs: { key: 'briefing' | 'wages' | 'udhaar' | 'orders'; due: boolean; build: () => Promise<string | null> }[] = [
+    { key: 'briefing', due: cfg.briefing.enabled && isDailyDue(now, cfg.briefing.time, runs.briefing ?? null), build: morningBriefing },
+    { key: 'wages', due: cfg.wages.enabled && isDailyDue(now, cfg.wages.time, runs.wages ?? null), build: () => wagesAlert(cfg.wages.minDays) },
+    { key: 'udhaar', due: cfg.udhaar.enabled && isDailyDue(now, cfg.udhaar.time, runs.udhaar ?? null, cfg.udhaar.weekday), build: udhaarReminder },
+    { key: 'orders', due: cfg.orders.enabled && isDailyDue(now, cfg.orders.time, runs.orders ?? null), build: () => stuckOrdersAlert(cfg.orders.minDays) },
+  ];
+  let last: string | null = null;
+  for (const job of jobs) {
+    if (force ? job.key !== force : !job.due) continue;
+    try {
+      const text = await job.build();
+      if (!force) store().markRun(job.key, day);
+      if (!text) continue;
+      await sendText(cfg.apiKey, to, text);
+      last = text;
+    } catch (e) {
+      reportError(`whatsapp:schedule:${job.key}`, e);
+      store().setStatus({ lastError: e instanceof Error ? e.message.slice(0, 120) : 'schedule failed' });
+      if (force) throw e;
+    }
+  }
+  return last;
+}
+
+function start(): void {
+  if (!stopped) return;
+  stopped = false;
+  store().setStatus({ running: true, lastError: null });
+  scheduleNext(0);
+  tickTimer = setInterval(() => {
+    if (shouldRun()) void runSchedules();
+  }, TICK_MS);
+  void runSchedules();
+}
+
+function stop(): void {
+  stopped = true;
+  if (pollTimer) clearTimeout(pollTimer);
+  if (tickTimer) clearInterval(tickTimer);
+  pollTimer = null;
+  tickTimer = null;
+  if (store().status.running) store().setStatus({ running: false });
+}
+
+/** Start or stop the poller to match the current settings and app state. */
+export function syncWhatsAppAgent(): void {
+  if (!wired) {
+    wired = true;
+    AppState.addEventListener('change', (_s: AppStateStatus) => syncWhatsAppAgent());
+    useWhatsAppStore.subscribe((s, prev) => {
+      if (s.config.enabled !== prev.config.enabled || s.config.apiKey !== prev.config.apiKey) syncWhatsAppAgent();
+    });
+    useSettingsStore.subscribe((s, prev) => {
+      if (s.aiEnabled !== prev.aiEnabled || s.aiProvider !== prev.aiProvider || s.aiKeys !== prev.aiKeys) syncWhatsAppAgent();
+    });
+    useCompanyStore.subscribe((s, prev) => {
+      if (s.activeCompanyId !== prev.activeCompanyId) syncWhatsAppAgent();
+    });
+  }
+  if (shouldRun()) start();
+  else stop();
+}
+
+/** Send a short message to the paired participant, to verify the key from the screen. */
+export async function sendTestMessage(): Promise<void> {
+  const cfg = store().config;
+  const to = targetParticipant();
+  if (!to) throw new Error('no target');
+  await sendText(cfg.apiKey, to, 'TameerBook agent is connected. Reply here to ask about your ledger.');
+}

@@ -0,0 +1,89 @@
+import { describe, expect, it } from 'vitest';
+
+import { clampWhatsApp, confirmFooter, isDailyDue, newActionId, optionsBlock, parseClock, parseCommand, resolveNumberedReply, toWhatsAppText } from './format';
+
+describe('toWhatsAppText', () => {
+  it('rewrites headings, bold and bullets for WhatsApp', () => {
+    expect(toWhatsAppText('## Cost:\n**Rs 5,52,500** this month.\n- Cement Rs 3,00,000\n- Sariya Rs 1,80,000')).toBe('*Cost:*\n*Rs 5,52,500* this month.\n• Cement Rs 3,00,000\n• Sariya Rs 1,80,000');
+  });
+  it('flattens tables into dotted lines and drops the separator row', () => {
+    expect(toWhatsAppText('| Worker | Days | Baqaya |\n|---|---|---|\n| Bilal | 18 | Rs 20,000 |')).toBe('Worker · Days · Baqaya\nBilal · 18 · Rs 20,000');
+  });
+  it('replaces dashes and strips code ticks', () => {
+    expect(toWhatsAppText('Cash — `Rs 1,000`')).toBe('Cash - Rs 1,000');
+  });
+});
+
+describe('clampWhatsApp', () => {
+  it('cuts on a line boundary with an ellipsis', () => {
+    const text = Array.from({ length: 50 }, (_, i) => `line ${i} ${'x'.repeat(90)}`).join('\n');
+    const out = clampWhatsApp(text, 1000);
+    expect(out.length).toBeLessThanOrEqual(1000);
+    expect(out.endsWith('…')).toBe(true);
+    expect(out.split('\n').at(-1)).toMatch(/^line \d+ x+…$/);
+  });
+});
+
+describe('numbered choices', () => {
+  it('renders and resolves them', () => {
+    expect(optionsBlock(['Gulberg House', 'Wapda Town'])).toBe('1. Gulberg House\n2. Wapda Town');
+    expect(resolveNumberedReply('2', ['Gulberg House', 'Wapda Town'])).toBe('Wapda Town');
+    expect(resolveNumberedReply('2.', ['a', 'b'])).toBe('b');
+    expect(resolveNumberedReply('7', ['a', 'b'])).toBe('7');
+    expect(resolveNumberedReply('Wapda', ['a', 'b'])).toBe('Wapda');
+  });
+});
+
+describe('parseCommand', () => {
+  it('reads confirm and cancel with an id, in any case, with or without a verb', () => {
+    expect(parseCommand('CONFIRM ACT-K9X2')).toEqual({ kind: 'confirm', id: 'ACT-K9X2' });
+    expect(parseCommand('yes act-k9x2')).toEqual({ kind: 'confirm', id: 'ACT-K9X2' });
+    expect(parseCommand('ACT-K9X2')).toEqual({ kind: 'confirm', id: 'ACT-K9X2' });
+    expect(parseCommand('haan ACT-K9X2')).toEqual({ kind: 'confirm', id: 'ACT-K9X2' });
+    expect(parseCommand('cancel ACT-K9X2')).toEqual({ kind: 'cancel', id: 'ACT-K9X2' });
+    expect(parseCommand('nahi ACT-K9X2')).toEqual({ kind: 'cancel', id: 'ACT-K9X2' });
+  });
+  it('treats a bare yes / no as acting on the latest proposal', () => {
+    expect(parseCommand('haan')).toEqual({ kind: 'confirmLatest' });
+    expect(parseCommand('Theek hai')).toEqual({ kind: 'confirmLatest' });
+    expect(parseCommand('ok!')).toEqual({ kind: 'confirmLatest' });
+    expect(parseCommand('nahi')).toEqual({ kind: 'cancelLatest' });
+    expect(parseCommand('rehne do')).toEqual({ kind: 'cancelLatest' });
+  });
+  it('leaves ordinary messages alone', () => {
+    expect(parseCommand('is mahine kitna kharcha hua')).toBeNull();
+    expect(parseCommand('haan Bilal ko 2000 diye')).toBeNull();
+  });
+});
+
+describe('ids and footer', () => {
+  it('makes short unambiguous ids', () => {
+    let i = 0;
+    const id = newActionId(() => [0.1, 0.5, 0.9, 0.3][i++ % 4]);
+    expect(id).toMatch(/^ACT-[A-HJ-NP-Z2-9]{4}$/);
+    expect(id).not.toMatch(/[IO01]/);
+  });
+  it('writes the footer in the reply language', () => {
+    expect(confirmFooter('ACT-AB12', 'roman')).toContain('CONFIRM ACT-AB12');
+    expect(confirmFooter('ACT-AB12', 'ur')).toContain('CANCEL ACT-AB12');
+    expect(confirmFooter('ACT-AB12', 'en')).toMatch(/^Reply/);
+  });
+});
+
+describe('schedule', () => {
+  it('parses clocks', () => {
+    expect(parseClock('09:00')).toBe(540);
+    expect(parseClock('9:05')).toBe(545);
+    expect(parseClock('25:00')).toBeNull();
+    expect(parseClock('nine')).toBeNull();
+  });
+  it('is due once per day after the time, and only on the chosen weekday when given', () => {
+    const at = new Date(2026, 8, 24, 9, 30); // Thursday
+    expect(isDailyDue(at, '09:00', null)).toBe(true);
+    expect(isDailyDue(at, '09:00', '2026-09-24')).toBe(false);
+    expect(isDailyDue(at, '09:00', '2026-09-23')).toBe(true);
+    expect(isDailyDue(new Date(2026, 8, 24, 8, 59), '09:00', null)).toBe(false);
+    expect(isDailyDue(at, '09:00', null, 4)).toBe(true);
+    expect(isDailyDue(at, '09:00', null, 1)).toBe(false);
+  });
+});
diff --git a/src/modules/whatsapp/access.ts b/src/modules/whatsapp/access.ts
new file mode 100644
index 0000000..76e0d55
--- /dev/null
+++ b/src/modules/whatsapp/access.ts
@@ -0,0 +1,51 @@
+/**
+ * WHO MAY TALK TO THE AGENT — pure whitelist matching.
+ *
+ * Meta's Cloud Agent API hides phone numbers behind participant ids such as
+ * `user:114937619824772`. A user who typed their own number in Settings
+ * cannot know that id, so the match is generous the way SubscribAI's is:
+ *   1. exact match on the phone, the bare id or the digits;
+ *   2. the participant the agent last paired with;
+ *   3. a digit suffix / prefix match on real phone numbers (7+ digits);
+ *   4. auto-bind: exactly ONE plain phone number in the list and no pairing
+ *      yet → the first participant that writes in becomes the admin.
+ * An empty whitelist means the agent is not open to anyone: the user must
+ * add at least their own number.
+ */
+export interface AccessConfig {
+  adminPhones: readonly string[];
+  lastActiveUserId?: string | null;
+}
+
+const digits = (s: string): string => s.replace(/[^0-9]/g, '');
+/** National digits: "03001234567" and "923001234567" both end in 3001234567. */
+const core = (s: string): string => digits(s).replace(/^0+/, '');
+
+export function isAdminParticipant(cfg: AccessConfig, from: string): boolean {
+  const allowed = cfg.adminPhones.map((p) => p.trim()).filter(Boolean);
+  if (allowed.length === 0) return false;
+  const bare = from.replace(/^user:/, '').trim();
+  const fromDigits = digits(from);
+
+  if (allowed.includes(from) || allowed.includes(bare) || (fromDigits && allowed.includes(fromDigits))) return true;
+
+  if (cfg.lastActiveUserId && (cfg.lastActiveUserId === from || (fromDigits && digits(cfg.lastActiveUserId) === fromDigits))) return true;
+
+  const fromCore = core(from);
+  for (const p of allowed) {
+    const d = core(p);
+    if (!d || !fromCore) continue;
+    if (d === fromCore) return true;
+    if (d.length >= 7 && fromCore.length >= 7 && (fromCore.endsWith(d) || d.endsWith(fromCore))) return true;
+  }
+
+  // Auto-bind: one plain number configured, nobody paired yet.
+  if (!cfg.lastActiveUserId && allowed.length === 1 && !allowed[0].startsWith('user:') && digits(allowed[0]).length >= 10) return true;
+
+  return false;
+}
+
+/** Split the Settings text field into a clean list. */
+export function parseAdminPhones(text: string): string[] {
+  return Array.from(new Set(text.split(/[,\n;]+/).map((p) => p.trim()).filter(Boolean)));
+}

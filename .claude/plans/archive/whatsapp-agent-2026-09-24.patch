diff --git a/src/modules/whatsapp/format.ts b/src/modules/whatsapp/format.ts
new file mode 100644
index 0000000..70caa10
--- /dev/null
+++ b/src/modules/whatsapp/format.ts
@@ -0,0 +1,137 @@
+/**
+ * WHATSAPP TEXT — pure helpers shared by the handler, the briefings and the
+ * tests. WhatsApp renders *bold*, _italic_ and plain lines; no headings, no
+ * tables, no chips. The assistant writes markdown for the in-app chat, so
+ * every reply is rewritten here before it is sent.
+ */
+
+/** WhatsApp caps a text message at 4,096 characters; keep a margin for the footer. */
+export const WHATSAPP_MAX_CHARS = 3900;
+
+/** A pipe table row → "a · b · c". */
+const tableRow = (line: string): string =>
+  line
+    .trim()
+    .replace(/^\||\|$/g, '')
+    .split('|')
+    .map((c) => c.trim())
+    .filter(Boolean)
+    .join(' · ');
+
+/** Markdown (headings, **bold**, tables, bullets) → WhatsApp text. */
+export function toWhatsAppText(markdown: string): string {
+  const lines = markdown.replace(/\r/g, '').split('\n');
+  const out: string[] = [];
+  for (const raw of lines) {
+    const line = raw.replace(/[—–]/g, '-');
+    // Table separator rows (|---|---|) carry nothing.
+    if (/^\s*\|?\s*:?-{2,}/.test(line) && /\|/.test(line)) continue;
+    if (/^\s*\|.*\|\s*$/.test(line) || (line.includes('|') && line.split('|').length >= 3)) {
+      out.push(tableRow(line));
+      continue;
+    }
+    let s = line;
+    s = s.replace(/^\s*#{1,6}\s*(.+?)\s*#*\s*$/, '*$1*');
+    s = s.replace(/\*\*(.+?)\*\*/g, '*$1*');
+    s = s.replace(/__(.+?)__/g, '_$1_');
+    s = s.replace(/^\s*[-*•]\s+/, '• ');
+    s = s.replace(/`([^`]+)`/g, '$1');
+    out.push(s.trimEnd());
+  }
+  return out
+    .join('\n')
+    .replace(/\n{3,}/g, '\n\n')
+    .trim();
+}
+
+/** Trim to the WhatsApp limit on a line boundary. */
+export function clampWhatsApp(text: string, max = WHATSAPP_MAX_CHARS): string {
+  if (text.length <= max) return text;
+  const cut = text.lastIndexOf('\n', max - 1);
+  return `${text.slice(0, cut > max / 2 ? cut : max - 1).trimEnd()}…`;
+}
+
+/** "OPTIONS" choices become a numbered list the user can answer by number or name. */
+export function optionsBlock(options: readonly string[]): string {
+  return options.map((o, i) => `${i + 1}. ${o}`).join('\n');
+}
+
+/**
+ * The user's reply to a numbered list: "2" → the second option. Anything
+ * else is passed through unchanged (they may have typed the name).
+ */
+export function resolveNumberedReply(text: string, options: readonly string[] | undefined): string {
+  const m = text.trim().match(/^(\d{1,2})[.)]?$/);
+  if (!m || !options?.length) return text;
+  const idx = Number(m[1]) - 1;
+  return idx >= 0 && idx < options.length ? options[idx] : text;
+}
+
+/** Action ids the user types back: short, unambiguous, upper case. */
+const ID_ALPHABET = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
+export function newActionId(random: () => number = Math.random): string {
+  let s = '';
+  for (let i = 0; i < 4; i++) s += ID_ALPHABET[Math.floor(random() * ID_ALPHABET.length)];
+  return `ACT-${s}`;
+}
+
+export type WaCommand = { kind: 'confirm'; id: string } | { kind: 'cancel'; id: string } | { kind: 'confirmLatest' } | { kind: 'cancelLatest' } | null;
+
+/**
+ * "CONFIRM ACT-K9X2", "yes ACT-K9X2", "ACT-K9X2", "cancel ACT-K9X2"; and the
+ * bare words a person actually types after a proposal: "haan", "ok", "yes",
+ * "confirm" (latest pending), "nahi", "no", "cancel" (drop latest pending).
+ */
+export function parseCommand(text: string): WaCommand {
+  const t = text.trim();
+  const withId = t.match(/^(?:confirm|yes|ok|okay|haan|han|ji|theek|save|karo|kar do|do)?\s*(ACT-[A-Z0-9]{4,})\s*$/i);
+  if (withId) return { kind: 'confirm', id: withId[1].toUpperCase() };
+  const cancelId = t.match(/^(?:cancel|no|nahi|nahin|abort|drop|stop|rehne do)\s+(ACT-[A-Z0-9]{4,})\s*$/i);
+  if (cancelId) return { kind: 'cancel', id: cancelId[1].toUpperCase() };
+  if (/^(?:confirm|yes|ok|okay|haan|han|ji haan|ji|theek hai|theek|save|save karo|kar do|done)\s*[.!]?$/i.test(t)) return { kind: 'confirmLatest' };
+  if (/^(?:cancel|no|nahi|nahin|abort|drop|rehne do|chhor do|stop)\s*[.!]?$/i.test(t)) return { kind: 'cancelLatest' };
+  return null;
+}
+
+/** The two-line footer under a proposed write. */
+export function confirmFooter(id: string, lang: 'ur' | 'roman' | 'en'): string {
+  switch (lang) {
+    case 'ur':
+      return `محفوظ کرنے کے لیے *CONFIRM ${id}* لکھیں، چھوڑنے کے لیے *CANCEL ${id}*۔`;
+    case 'roman':
+      return `Save karne ke liye *CONFIRM ${id}* likhein, chhorne ke liye *CANCEL ${id}*.`;
+    default:
+      return `Reply *CONFIRM ${id}* to save, or *CANCEL ${id}* to drop it.`;
+  }
+}
+
+/** "HH:MM" → minutes since midnight, or null when malformed. */
+export function parseClock(hhmm: string): number | null {
+  const m = hhmm.trim().match(/^(\d{1,2}):(\d{2})$/);
+  if (!m) return null;
+  const h = Number(m[1]);
+  const min = Number(m[2]);
+  if (h > 23 || min > 59) return null;
+  return h * 60 + min;
+}
+
+/**
+ * Is a daily job due now? True once per local day, when the clock has passed
+ * the scheduled time and the job has not run today. `lastRun` is the ISO day
+ * of the last run. The scheduler ticks every minute, so a phone that was
+ * asleep at 09:00 sends the briefing when the app next wakes.
+ */
+export function isDailyDue(now: Date, hhmm: string, lastRunDay: string | null, weekday?: number): boolean {
+  const at = parseClock(hhmm);
+  if (at === null) return false;
+  if (weekday !== undefined && now.getDay() !== weekday) return false;
+  const today = localDay(now);
+  if (lastRunDay === today) return false;
+  return now.getHours() * 60 + now.getMinutes() >= at;
+}
+
+/** Local calendar day as YYYY-MM-DD. */
+export function localDay(d: Date): string {
+  const p = (n: number) => String(n).padStart(2, '0');
+  return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`;
+}
